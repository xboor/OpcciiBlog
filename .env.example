# 部署目标：main = Cloudflare 主站；backup = Azure 备用站
# 备用站会自动：不生成 sitemap、robots.txt 不指向 sitemap、关闭 Cloudflare 统计
#（canonical 恒定指向主域，备用站不做 noindex）
PUBLIC_DEPLOY_TARGET=main

# Google Search Console 验证（可选）
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Web Analytics beacon token（可选，仅主站生效）
PUBLIC_CF_ANALYTICS_TOKEN=

# giscus 评论（可选，四项缺任意一项则不渲染评论区）
# 获取方式：https://giscus.app/ 选择公开仓库后复制生成的配置
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=
PUBLIC_GISCUS_CATEGORY_ID=
