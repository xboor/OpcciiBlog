---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const sortedPosts = getSortedPosts(await getCollection("posts"));
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const tags = getUniqueTags(sortedPosts).slice(0, 6);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout home-layout"
  >
    <section id="hero" class="home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span>{t.home.eyebrow}
        </p>
        <h1 id="hero-title">
          {t.home.headline}<br /><span>{t.home.headlineAccent}</span>
        </h1>
        <p class="hero-intro">{t.home.intro}</p>
        <div class="hero-actions">
          <a class="button-primary" href="#writing"
            >{t.home.startReading}<IconArrowRight aria-hidden="true" /></a
          >
          <a class="quiet-link" href={getRelativeLocaleUrl(locale, "about")}
            >{t.nav.about}<span aria-hidden="true"> ↗</span></a
          >
        </div>
        <div class="hero-socials">
          <Socials />
          <span class="social-divider" aria-hidden="true"></span>
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="rss-link"><IconRss aria-hidden="true" />RSS</a
          >
          <span class="social-divider" aria-hidden="true"></span>
          <a
            href="https://backup.opccii.com"
            class="mirror-link"
            title={t.home.mirrorHint}>{t.home.mirrorLink}</a
          >
        </div>
      </div>
      <aside class="hero-note">
        <span class="note-index" aria-hidden="true">01 / ∞</span>
        <p>{t.home.spaceNote}</p>
        <a href={getRelativeLocaleUrl(locale, "about")}
          >{t.home.aboutSpace}<IconArrowRight aria-hidden="true" /></a
        >
      </aside>
    </section>

    <div id="writing" class="writing-heading">
      <div><p class="eyebrow">JOURNAL</p><h2>{t.home.writing}</h2></div>
      <a class="quiet-link" href={getRelativeLocaleUrl(locale, "posts")}
        >{t.home.allPosts}<IconArrowRight aria-hidden="true" /></a
      >
    </div>
    {
      featuredPosts.length > 0 && (
        <section id="featured" aria-label={t.home.featured}>
          <ul class="home-posts">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" aria-label={t.home.recentPosts}>
          <ul class="home-posts">
            {recentPosts.slice(0, config.posts.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }
    {
      tags.length > 0 && (
        <section class="topic-section" aria-labelledby="topic-heading">
          <h2 id="topic-heading">{t.home.topics}</h2>
          <ul class="topic-list">
            {tags.map(({ tag, tagName }) => (
              <li>
                <a href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}>
                  <span aria-hidden="true">#</span>
                  {tagName}
                  <IconArrowRight aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = document.querySelector<HTMLElement>(
      "[data-layout='index']"
    )?.dataset;
    if (indexLayout)
      sessionStorage.setItem(
        "backUrl",
        indexLayout.homePath ?? import.meta.env.BASE_URL
      );
  });
</script>
