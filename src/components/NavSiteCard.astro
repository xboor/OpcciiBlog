---
type Site = { name: string; url: string; icon?: string; desc?: string; pinned?: boolean };

const { site } = Astro.props as { site: Site };

const siteHost = () => {
  try {
    return new URL(site.url).hostname;
  } catch {
    return site.url;
  }
};

// icon 字段留空时，自动取目标站点的 favicon
const iconSrc = site.icon || `https://favicon.im/${siteHost()}?larger=true`;
const searchKey = [site.name, site.desc ?? "", siteHost()]
  .join(" ")
  .toLowerCase();
---

<a
  class="nav-site"
  href={site.url}
  target="_blank"
  rel="noopener noreferrer"
  data-search={searchKey}
>
  <img
    class="nav-site-icon"
    src={iconSrc}
    alt=""
    width="22"
    height="22"
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
  />
  <span class="nav-site-body">
    <span class="nav-site-name">
      {site.name}
      {
        site.pinned && (
          <svg class="nav-pin" viewBox="0 0 24 24" fill="currentColor" aria-label="置顶">
            <path d="M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z" />
          </svg>
        )
      }
    </span>
    {site.desc && <span class="nav-site-desc">{site.desc}</span>}
  </span>
</a>

<style is:global>
  .nav-site {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .nav-site:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    transform: translateY(-2px);
    box-shadow: var(--soft-shadow);
  }
  .nav-site-icon {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    object-fit: contain;
  }
  .nav-site-avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-size: 12px;
    font-weight: 600;
  }
  .nav-site-body {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .nav-site-name {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }
  .nav-pin {
    flex: none;
    width: 13px;
    height: 13px;
    color: var(--accent);
  }
  .nav-site-desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--muted-foreground);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 图标视图：紧凑网格，图标为主 */
  .nav-content[data-view="icons"] .nav-grid {
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }
  .nav-content[data-view="icons"] .nav-site {
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    padding: 16px 8px 13px;
    border-radius: 16px;
    text-align: center;
  }
  .nav-content[data-view="icons"] .nav-site-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
  }
  .nav-content[data-view="icons"] .nav-site-avatar {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    font-size: 16px;
  }
  .nav-content[data-view="icons"] .nav-site-name {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 550;
  }
  .nav-content[data-view="icons"] .nav-site-desc {
    display: none;
  }
  .nav-content[data-view="icons"] .nav-group + .nav-group {
    margin-top: 22px;
  }
</style>
