---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale, getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

// 语言切换：locale 以 currentLocale 为准 —— fallback rewrite 生成 /en/ 页面时
// Astro.url.pathname 是回退后的 zh 路径，不能用它判断当前语言
const { site, features } = config;
const pathNoBase = stripBase(Astro.url.pathname);
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const logicalPath = stripLocale(pathNoBase, locale).replace(/\/+$/, "");
const targetLocale = locale === "en" ? "zh" : "en";
const langHref = getRelativeLocaleUrl(targetLocale, logicalPath);

const currentPath = logicalPath;
const links = [
  { path: "posts", label: t.nav.posts },
  { path: "tags", label: t.nav.tags },
  ...(features.showArchives
    ? [{ path: "archives", label: t.nav.archives }]
    : []),
  { path: "about", label: t.nav.about },
  { path: "nav", label: t.nav.nav },
];
---

<a id="skip-to-content" href="#main-content" class="skip-link"
  >{t.a11y.skipToContent}</a
>
<header class="site-header">
  <a class="site-brand" href={getRelativeLocaleUrl(locale, "")}>
    <img
      class="brand-mark"
      src={getAssetPath("avatar.jpg")}
      alt=""
      width="36"
      height="36"
      loading="eager"
      decoding="async"
    />
    <span>{site.title}</span>
  </a>
  <nav class="site-nav" aria-label={t.a11y.mainNavigation}>
    <ul id="menu-items" class="nav-links">
      {
        links.map(({ path, label }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, path)}
              aria-current={
                currentPath.split("/").includes(path) ? "page" : undefined
              }
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="nav-tools">
      <a
        class="lang-button"
        href={langHref}
        title={t.nav.langSwitch}
        aria-label={t.nav.langSwitch}
      >
        {t.nav.langSwitch}
      </a>
      {
        features.search !== false && (
          <a
            class="icon-button"
            href={getRelativeLocaleUrl(locale, "search")}
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch aria-hidden="true" />
          </a>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="icon-button"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
          >
            <>
              <IconMoon class="theme-moon" aria-hidden="true" />
              <IconSunHigh class="theme-sun" aria-hidden="true" />
            </>
          </button>
        )
      }
      <button
        id="menu-btn"
        class="icon-button mobile-menu-button"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconMenuDeep class="menu-open-icon" aria-hidden="true" /><IconX
          class="menu-close-icon"
          aria-hidden="true"
        />
      </button>
    </div>
  </nav>
</header>
<noscript
  ><style>
    .mobile-menu-button {
      display: none !important;
    }
    @media (max-width: 639px) {
      .site-header {
        position: relative;
        inset: auto;
        transform: none;
        margin: 0 auto 2rem;
        flex-wrap: wrap;
      }
      .site-nav {
        flex-wrap: wrap;
      }
      .nav-links {
        display: flex !important;
        position: static !important;
        box-shadow: none !important;
      }
      body {
        padding-top: 1rem !important;
      }
    }
  </style></noscript
>

<script>
  function initHeader() {
    // Make the native skip link move keyboard focus as well as the viewport.
    document.getElementById("main-content")?.setAttribute("tabindex", "-1");
    const header = document.querySelector<HTMLElement>(".site-header");
    const button = header?.querySelector<HTMLButtonElement>("#menu-btn");
    if (!header || !button || header.dataset.ready) return;
    header.dataset.ready = "true";
    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? "Menu"
      );
      header.classList.toggle("menu-is-open", open);
    };
    button.addEventListener("click", () =>
      setOpen(button.getAttribute("aria-expanded") !== "true")
    );
    header.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        setOpen(false);
        button.focus();
      }
    });
    header.addEventListener("focusout", event => {
      if (!header.contains(event.relatedTarget as Node)) setOpen(false);
    });
    const controller = new AbortController();
    document.addEventListener(
      "click",
      event => {
        if (!header.contains(event.target as Node)) setOpen(false);
      },
      { signal: controller.signal }
    );
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });
  }
  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>

<style>
  img.brand-mark {
    object-fit: cover;
    padding-bottom: 0;
  }
  .lang-button {
    display: grid;
    place-items: center;
    height: 40px;
    min-width: 40px;
    padding: 0 8px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.18s,
      color 0.18s;
  }
  .lang-button:hover {
    background: var(--muted);
    color: var(--foreground);
  }
  @media (max-width: 639px) {
    .lang-button {
      height: 36px;
      min-width: 36px;
      padding: 0 6px;
    }
  }
</style>
