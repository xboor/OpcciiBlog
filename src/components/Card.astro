---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Datetime from "./Datetime.astro";

type Props = { variant?: "h2" | "h3" } & CollectionEntry<"posts">;
const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<li class="post-card" data-featured={data.featured ? "true" : undefined}>
  <div class="post-card-meta">
    <Datetime {...data} />
    {data.featured && <span class="featured-label">{t.home.featured}</span>}
  </div>
  <Heading class="post-card-title" transition:name={toTransitionName(id)}>
    <a href={getPostUrl(id, filePath, Astro.currentLocale)}>{data.title}</a>
  </Heading>
  <p class="post-card-description">{data.description}</p>
  <div class="post-card-bottom">
    <span class="post-card-tags"
      >{data.tags.slice(0, 3).map(tag => <span>#{tag}</span>)}</span
    >
    <span class="post-card-read" aria-hidden="true"
      >{t.home.readPost}<IconArrowRight /></span
    >
  </div>
</li>
