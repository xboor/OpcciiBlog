{
  "$schema": "https://aka.ms/staticwebapp.config.schema.json",
  "trailingSlash": "always",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".woff2": "font/woff2",
    ".json": "application/json"
  }
}
